# IncuBrix Video Editor Environment Configuration

# Application Metadata
APP_NAME="IncuBrix Video Editor"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# Server Binding
HOST=0.0.0.0
PORT=8000

# Storage Provider (local or s3)
STORAGE_TYPE=local
STORAGE_PATH=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=incubrix
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Speech-to-Text Transcription Provider (mock, whisper, or api)
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL_SIZE=base

# Natural Language Parser Provider (mock or openai)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Video Limits & File Formats
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=mp4,mov,webm,mkv
MAX_VIDEO_DURATION_S=7200

# Media Processing Executables
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Timeline Coordinate Policy: 'current' (current timeline time) or 'original' (source time)
TIME_POLICY=current
